{
  "name": "vscode-portfolio",
  "version": "3.2.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/build.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx lib/db/seed.ts",
    "admin:hash": "tsx scripts/hash-password.ts",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:db": "bash scripts/run-e2e-db.sh",
    "db:restore-drill": "bash scripts/verify-neon-restore.sh",
    "test:restore-drill": "bash scripts/test-restore-drill.sh",
    "seo:indexnow": "tsx scripts/submit-indexnow.ts",
    "build:next": "next build",
    "db:preflight": "tsx scripts/db-preflight.ts",
    "bundle:github": "node scripts/report-github-bundle.mjs",
    "test:coverage": "rm -rf coverage && c8 --reporter=lcovonly --reporter=text --all --include='public/theme-init.v1.js' --include='lib/admin-access.ts' --include='lib/admin/validation.ts' --include='lib/admin/limits.ts' --include='lib/build-policy.ts' --include='lib/agent-discovery.ts' --include='lib/content-relations.ts' --include='lib/db/content-authority.ts' --include='lib/discovery.ts' --include='lib/homepage-content.ts' --include='lib/page-markdown.ts' --include='lib/person-identity.ts' --include='lib/site-shell.ts' --include='lib/ui-icons.ts' --include='lib/static-assets.ts' npm test",
    "icons:generate": "tsx scripts/generate-ui-icons.ts",
    "report:html-density": "node scripts/report-html-density.mjs",
    "test:homepage-density": "node scripts/assert-homepage-density.mjs",
    "test:e2e:matrix": "playwright test --project=firefox-smoke --project=webkit-smoke",
    "test:e2e:visual": "playwright test --project=chromium-visual",
    "test:drizzle-upgrade": "tsx scripts/test-drizzle-v1-upgrade.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@next/third-parties": "^16.2.12",
    "@sentry/nextjs": "^10.65.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-github-calendar": "^5.0.6",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.17.2",
    "zod": "^4.4.3",
    "drizzle-orm": "1.0.0-rc.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.11",
    "@types/react-dom": "^19.0.4",
    "c8": "^12.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "^16.2.12",
    "tsx": "^4.23.0",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "postcss": "8.5.18",
    "fast-uri": "3.1.4",
    "sharp": "0.35.3"
  },
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.23.1 <23",
    "npm": ">=10.9.8 <11"
  }
}
