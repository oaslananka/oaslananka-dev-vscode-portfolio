    "/api/agent/v1/proposals": {
      "post": {
        "operationId": "submitContentProposal",
        "summary": "Submit a content edit for owner review without applying it",
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "header",
            "name": "If-None-Match",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "*"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "resource",
                  "patch"
                ],
                "additionalProperties": false,
                "properties": {
                  "resource": {
                    "type": "string"
                  },
                  "patch": {
                    "type": "object",
                    "minProperties": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Pending review"
          },
          "200": {
            "description": "Identical existing proposal"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Publication prohibited"
          },
          "409": {
            "description": "Stale revision or reused key"
          },
          "422": {
            "description": "Invalid content"
          },
          "503": {
            "description": "Writer disabled"
          }
        },
        "description": "Edits require If-Match. New unpublished article drafts require If-None-Match: * and resource /api/agent/v1/posts. Proposal does not create content."
      }
    },
    "/api/agent/v1/proposals/{requestId}": {
      "get": {
        "operationId": "checkContentProposal",
        "summary": "Poll manual review status and retrieve approved proof",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pending, rejected, expired or approved (with signed approval)"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          },
          "503": {
            "description": "Writer disabled"
          }
        }
      }
    },
    "/api/agent/v1/posts": {
      "post": {
        "operationId": "createUnpublishedArticleDraft",
        "summary": "Create an unpublished article only after explicit admin approval",
        "parameters": [
          {
            "in": "header",
            "name": "If-None-Match",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "*"
              ]
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "header",
            "name": "X-Agent-Approval",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "slug"
                ],
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "slug": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  },
                  "excerpt": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  },
                  "coverImage": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 80
                    },
                    "maxItems": 20
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Exactly one unpublished draft created or exact request retried"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Approval missing or mismatched"
          },
          "409": {
            "description": "Slug or idempotency conflict"
          },
          "422": {
            "description": "Invalid draft"
          },
          "428": {
            "description": "Creation precondition required"
          },
          "503": {
            "description": "Write mode disabled"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "agentWriteBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Separate write key, never the read-only key"
      }
    }
  }
}
