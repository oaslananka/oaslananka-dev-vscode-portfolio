    "/api/agent/v1/posts/{slug}": {
      "patch": {
        "operationId": "patchPost",
        "summary": "Update existing article; publishing fields forbidden",
        "description": "Disabled until a distinct write secret and explicit feature switch are configured. Requires current record revision and accepts only approved content fields.",
        "parameters": [
